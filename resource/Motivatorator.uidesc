        <view class="CTextLabel" origin="22,114" size="120,20" title="CHARACTER" font="small" font-color="muted" transparent="true"/><view class="COptionMenu" origin="150,108" size="210,32" control-tag="character" font="option" font-color="cream" back-color="metal" frame-color="amber" menu-check-style="true"/>
        <view class="CTextLabel" origin="22,158" size="120,20" title="LANGUAGE" font="small" font-color="muted" transparent="true"/><view class="COptionMenu" origin="150,152" size="210,32" control-tag="language" font="option" font-color="cream" back-color="metal" frame-color="amber" menu-check-style="true"/>
        <view class="CTextLabel" origin="22,202" size="120,20" title="INTERVAL" font="small" font-color="muted" transparent="true"/><view class="COptionMenu" origin="150,196" size="210,32" control-tag="interval" font="option" font-color="cream" back-color="metal" frame-color="amber" menu-check-style="true"/>
        <view class="CTextLabel" origin="400,70" size="100,20" title="SILENCE" font="small" font-color="muted" transparent="true"/><view class="CTextButton" origin="500,64" size="140,32" title="MUTE ME" control-tag="mute" font="option" font-color="cream" back-color="metal" frame-color="amber"/>
        <view class="CTextButton" origin="500,258" size="140,34" title="BACK" control-tag="options" font="option" font-color="amber" back-color="metal" frame-color="amber" kick-style="true"/>
