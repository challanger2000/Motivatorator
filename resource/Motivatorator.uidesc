<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <control-tags>
    <control-tag name="mode" tag="100"/>
    <control-tag name="next" tag="101"/>
    <control-tag name="mute" tag="102"/>
    <control-tag name="options" tag="103"/>
    <control-tag name="language" tag="104"/>
    <control-tag name="interval" tag="105"/>
    <control-tag name="character" tag="106"/>
    <control-tag name="phrase" tag="107"/>
    <control-tag name="tone" tag="108"/>
  </control-tags>

  <fonts>
    <font name="title" font-name="Arial" size="28" bold="true"/>
    <font name="mode" font-name="Arial" size="14" bold="true"/>
    <font name="quote" font-name="Arial" size="18" bold="true"/>
    <font name="button" font-name="Arial" size="13" bold="true"/>
    <font name="tiny" font-name="Arial" size="10" bold="false"/>
    <font name="face" font-name="Arial" size="38" bold="true"/>
    <font name="name" font-name="Arial" size="17" bold="true"/>
  </fonts>

  <colors>
    <color name="bg" rgba="#121419ff"/>
    <color name="panel" rgba="#20242cff"/>
    <color name="panel2" rgba="#292e38ff"/>
    <color name="text" rgba="#f5f5f5ff"/>
    <color name="muted" rgba="#9fa7b5ff"/>
    <color name="buttonbg" rgba="#303641ff"/>
    <color name="motivate" rgba="#39d98aff"/>
    <color name="motivatebg" rgba="#172923ff"/>
    <color name="demotivate" rgba="#ff5c5cff"/>
    <color name="demotivatebg" rgba="#2b181aff"/>
    <color name="mixed" rgba="#f0b84bff"/>
    <color name="mixedbg" rgba="#292319ff"/>
    <color name="steel" rgba="#8ea0b8ff"/>
    <color name="purple" rgba="#bd78ffff"/>
  </colors>

  <!-- GNOMI expressions -->
  <template name="GnomiMot" class="CViewContainer" size="190,182" background-color="motivatebg">
    <view class="CTextLabel" origin="12,16" size="166,58" title="^_^" font="face" font-color="motivate" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,80" size="166,28" title="GNOMI" font="name" font-color="text" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,112" size="166,44" title="STUDIO GOBLIN\nAPPROVES" font="tiny" font-color="motivate" transparent="true" text-alignment="center"/>
  </template>
  <template name="GnomiDemo" class="CViewContainer" size="190,182" background-color="demotivatebg">
    <view class="CTextLabel" origin="12,16" size="166,58" title="-_-" font="face" font-color="demotivate" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,80" size="166,28" title="GNOMI" font="name" font-color="text" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,112" size="166,44" title="HAS HEARD\nENOUGH" font="tiny" font-color="demotivate" transparent="true" text-alignment="center"/>
  </template>
  <template name="GnomiMixedPos" class="CViewContainer" size="190,182" background-color="mixedbg">
    <view class="CTextLabel" origin="12,16" size="166,58" title="@_@" font="face" font-color="motivate" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,80" size="166,28" title="GNOMI" font="name" font-color="text" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,112" size="166,44" title="MIXED FEELINGS\nGOOD MOMENT" font="tiny" font-color="motivate" transparent="true" text-alignment="center"/>
  </template>
  <template name="GnomiMixedNeg" class="CViewContainer" size="190,182" background-color="mixedbg">
    <view class="CTextLabel" origin="12,16" size="166,58" title="@_@" font="face" font-color="demotivate" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,80" size="166,28" title="GNOMI" font="name" font-color="text" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,112" size="166,44" title="MIXED FEELINGS\nBAD MOMENT" font="tiny" font-color="demotivate" transparent="true" text-alignment="center"/>
  </template>
  <template name="GnomiMixed" class="CViewContainer" size="190,182" background-color="mixedbg">
    <view class="UIViewSwitchContainer" origin="0,0" size="190,182" template-names="GnomiMixedPos,GnomiMixedNeg" template-switch-control="tone" animation-time="0"/>
  </template>
  <template name="Gnomi" class="CViewContainer" size="190,182" background-color="panel">
    <view class="UIViewSwitchContainer" origin="0,0" size="190,182" template-names="GnomiMot,GnomiDemo,GnomiMixed" template-switch-control="mode" animation-time="0"/>
  </template>

  <!-- ROCKY expressions -->
  <template name="RockyMot" class="CViewContainer" size="190,182" background-color="motivatebg">
    <view class="CTextLabel" origin="12,16" size="166,58" title="[ + + ]" font="face" font-color="motivate" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,80" size="166,28" title="ROCKY" font="name" font-color="text" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,112" size="166,44" title="SYSTEM STATUS\nIMPRESSED" font="tiny" font-color="motivate" transparent="true" text-alignment="center"/>
  </template>
  <template name="RockyDemo" class="CViewContainer" size="190,182" background-color="demotivatebg">
    <view class="CTextLabel" origin="12,16" size="166,58" title="[ - - ]" font="face" font-color="demotivate" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,80" size="166,28" title="ROCKY" font="name" font-color="text" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,112" size="166,44" title="ERROR 808\nIDEA NOT FOUND" font="tiny" font-color="demotivate" transparent="true" text-alignment="center"/>
  </template>
  <template name="RockyMixedPos" class="CViewContainer" size="190,182" background-color="mixedbg">
    <view class="CTextLabel" origin="12,16" size="166,58" title="[ ? + ]" font="face" font-color="motivate" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,80" size="166,28" title="ROCKY" font="name" font-color="text" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,112" size="166,44" title="CALCULATING...\nSURPRISINGLY GOOD" font="tiny" font-color="motivate" transparent="true" text-alignment="center"/>
  </template>
  <template name="RockyMixedNeg" class="CViewContainer" size="190,182" background-color="mixedbg">
    <view class="CTextLabel" origin="12,16" size="166,58" title="[ ! ? ]" font="face" font-color="demotivate" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,80" size="166,28" title="ROCKY" font="name" font-color="text" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,112" size="166,44" title="CALCULATING...\nOH DEAR" font="tiny" font-color="demotivate" transparent="true" text-alignment="center"/>
  </template>
  <template name="RockyMixed" class="CViewContainer" size="190,182" background-color="mixedbg">
    <view class="UIViewSwitchContainer" origin="0,0" size="190,182" template-names="RockyMixedPos,RockyMixedNeg" template-switch-control="tone" animation-time="0"/>
  </template>
  <template name="Rocky" class="CViewContainer" size="190,182" background-color="panel">
    <view class="UIViewSwitchContainer" origin="0,0" size="190,182" template-names="RockyMot,RockyDemo,RockyMixed" template-switch-control="mode" animation-time="0"/>
  </template>

  <!-- D.O.M. expressions -->
  <template name="DomMot" class="CViewContainer" size="190,182" background-color="motivatebg">
    <view class="CTextLabel" origin="12,16" size="166,58" title="}:D" font="face" font-color="purple" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,80" size="166,28" title="D.O.M." font="name" font-color="text" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,112" size="166,44" title="DARKNESS\nAPPROVES" font="tiny" font-color="motivate" transparent="true" text-alignment="center"/>
  </template>
  <template name="DomDemo" class="CViewContainer" size="190,182" background-color="demotivatebg">
    <view class="CTextLabel" origin="12,16" size="166,58" title="}:|" font="face" font-color="demotivate" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,80" size="166,28" title="D.O.M." font="name" font-color="text" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,112" size="166,44" title="NOT ANGRY\nJUST DISAPPOINTED" font="tiny" font-color="demotivate" transparent="true" text-alignment="center"/>
  </template>
  <template name="DomMixedPos" class="CViewContainer" size="190,182" background-color="mixedbg">
    <view class="CTextLabel" origin="12,16" size="166,58" title="}:?" font="face" font-color="motivate" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,80" size="166,28" title="D.O.M." font="name" font-color="text" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,112" size="166,44" title="CONFUSED\nBUT PLEASED" font="tiny" font-color="motivate" transparent="true" text-alignment="center"/>
  </template>
  <template name="DomMixedNeg" class="CViewContainer" size="190,182" background-color="mixedbg">
    <view class="CTextLabel" origin="12,16" size="166,58" title="}:?" font="face" font-color="demotivate" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,80" size="166,28" title="D.O.M." font="name" font-color="text" transparent="true" text-alignment="center"/>
    <view class="CTextLabel" origin="12,112" size="166,44" title="CONFUSED\nAND CONCERNED" font="tiny" font-color="demotivate" transparent="true" text-alignment="center"/>
  </template>
  <template name="DomMixed" class="CViewContainer" size="190,182" background-color="mixedbg">
    <view class="UIViewSwitchContainer" origin="0,0" size="190,182" template-names="DomMixedPos,DomMixedNeg" template-switch-control="tone" animation-time="0"/>
  </template>
  <template name="Dom" class="CViewContainer" size="190,182" background-color="panel">
    <view class="UIViewSwitchContainer" origin="0,0" size="190,182" template-names="DomMot,DomDemo,DomMixed" template-switch-control="mode" animation-time="0"/>
  </template>

  <template name="MainPage" class="CViewContainer" size="620,306" background-color="bg">
    <view class="UIViewSwitchContainer" origin="20,16" size="190,182" template-names="Gnomi,Rocky,Dom" template-switch-control="character" animation-time="0"/>

    <view class="CTextLabel" origin="230,16" size="370,24" title="YOUR COMPLETELY UNNECESSARY STUDIO COMPANION" font="tiny" font-color="muted" transparent="true" text-alignment="center"/>
    <view class="CParamDisplay" origin="230,48" size="370,150" control-tag="phrase" font="quote" font-color="text" back-color="panel2" frame-color="mixed" frame-width="1" text-alignment="center"/>

    <view class="CTextLabel" origin="20,214" size="130,20" title="MODE" font="tiny" font-color="muted" transparent="true"/>
    <view class="COptionMenu" origin="20,236" size="190,34" control-tag="mode" font="button" font-color="text" back-color="buttonbg" frame-color="mixed" menu-check-style="true"/>
    <view class="CTextButton" origin="230,236" size="170,34" title="NEXT" control-tag="next" font="button" font-color="text" back-color="buttonbg" frame-color="mixed"/>
    <view class="CTextButton" origin="420,236" size="180,34" title="MUTE ME" control-tag="mute" font="button" font-color="text" back-color="buttonbg" frame-color="mixed"/>
    <view class="CTextLabel" origin="20,282" size="580,18" title="No audio analysis. No DSP tricks. Just judgement." font="tiny" font-color="muted" transparent="true" text-alignment="center"/>
  </template>

  <template name="OptionsPage" class="CViewContainer" size="620,306" background-color="panel">
    <view class="CTextLabel" origin="20,18" size="580,34" title="OPTIONS" font="name" font-color="mixed" transparent="true" text-alignment="center"/>

    <view class="CTextLabel" origin="90,74" size="150,22" title="CHARACTER" font="tiny" font-color="muted" transparent="true"/>
    <view class="COptionMenu" origin="250,68" size="280,34" control-tag="character" font="button" font-color="text" back-color="buttonbg" frame-color="mixed" menu-check-style="true"/>

    <view class="CTextLabel" origin="90,126" size="150,22" title="LANGUAGE" font="tiny" font-color="muted" transparent="true"/>
    <view class="COptionMenu" origin="250,120" size="280,34" control-tag="language" font="button" font-color="text" back-color="buttonbg" frame-color="mixed" menu-check-style="true"/>

    <view class="CTextLabel" origin="90,178" size="150,22" title="INTERVAL" font="tiny" font-color="muted" transparent="true"/>
    <view class="COptionMenu" origin="250,172" size="280,34" control-tag="interval" font="button" font-color="text" back-color="buttonbg" frame-color="mixed" menu-check-style="true"/>

    <view class="CTextButton" origin="220,236" size="180,36" title="BACK" control-tag="options" font="button" font-color="text" back-color="buttonbg" frame-color="mixed"/>
    <view class="CTextLabel" origin="20,282" size="580,18" title="GNOMI is the default. ROCKY and D.O.M. are equally judgemental." font="tiny" font-color="muted" transparent="true" text-alignment="center"/>
  </template>

  <template name="view" class="CViewContainer" size="660,390" background-color="bg">
    <view class="CTextLabel" origin="20,12" size="620,42" title="MOTIVATORATOR" font="title" font-color="mixed" transparent="true" text-alignment="center"/>
    <view class="CTextButton" origin="564,18" size="76,28" title="OPTIONS" control-tag="options" font="tiny" font-color="text" back-color="buttonbg" frame-color="mixed"/>
    <view class="UIViewSwitchContainer" origin="20,66" size="620,306" template-names="MainPage,OptionsPage" template-switch-control="options" animation-time="0"/>
  </template>
</vstgui-ui-description>
