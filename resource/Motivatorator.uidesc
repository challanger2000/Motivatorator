<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <control-tags>
    <control-tag name="mode" tag="100"/><control-tag name="mute" tag="102"/><control-tag name="options" tag="103"/><control-tag name="language" tag="104"/><control-tag name="interval" tag="105"/><control-tag name="character" tag="106"/><control-tag name="phrase" tag="107"/>
  </control-tags>
  <fonts>
    <font name="brand" font-name="Arial" size="24" bold="true"/><font name="screen" font-name="Arial" size="21" bold="true"/><font name="small" font-name="Arial" size="11" bold="true"/><font name="option" font-name="Arial" size="13" bold="true"/><font name="face" font-name="Arial" size="54" bold="true"/>
  </fonts>
  <colors>
    <color name="room" rgba="#171512ff"/><color name="wood" rgba="#302820ff"/><color name="metal" rgba="#403c34ff"/><color name="metalDark" rgba="#24231fff"/><color name="screenGlass" rgba="#07120dff"/><color name="screenGlow" rgba="#79f2a6ff"/><color name="cream" rgba="#e7dfc8ff"/><color name="amber" rgba="#e4a84cff"/><color name="muted" rgba="#aaa38fff"/><color name="black" rgba="#080808ff"/>
  </colors>
  <template name="view" class="CViewContainer" size="760,430" background-color="room">
    <view class="CViewContainer" origin="8,8" size="744,414" background-color="wood"><view class="CViewContainer" origin="10,10" size="724,394" background-color="room">
